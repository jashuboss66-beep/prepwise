# Flask configuration for the local prototype.
# Replace this value with a private random string before using the app beyond local testing.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
DAILY_QUIZ_CUTOFF_UTC_HOUR=23

# Optional: OpenRouter API key for the free NVIDIA Nemotron 3 Ultra model.
# Leave blank to use the built-in local AI fallbacks.
OPENROUTER_API_KEY=

# Optional: override the public Wandbox compiler API base URL.
# No Judge0 token or OpenRouter key is used for code execution.
WANDBOX_API_URL=https://wandbox.org/api
